{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "hongbo",
	"compatibility_date": "2026-10-02",
	// 대시보드에서 넣은 일반 변수(Variables)가 배포할 때마다 지워지지 않도록 유지합니다.
	"keep_vars": true,
	// Worker Previews requires this block. Production secrets and service bindings
	// are deliberately not inherited; DB-backed preview testing needs a test DB.
	"previews": {},
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// OpenNext 기본 자기 참조 바인딩 (서비스 이름은 위의 name 과 같아야 합니다)
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hongbo"
		}
	],
	"observability": {
		"enabled": true
	}
	// 환경변수/비밀 값은 이 파일에 적지 않습니다. README 의 "Cloudflare 배포" 항목을 따라 대시보드에서 설정하세요.
}
